# Local scaffold only. No provider secrets are needed.
HOST=127.0.0.1
PORT=8787
# PostgreSQL runtime connection; use a restricted role, never the migration owner.
# DATABASE_URL=postgresql://runtime_user:password@localhost:5432/kele_test
# Secrets belong in local environment or cloud secret storage, never committed files.

# Browser session origin must match exactly. Production requires HTTPS.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Generic signed JWT provider adapter: configure all three together with DATABASE_URL.
# Verify provider compatibility before configuring; these are NOT CloudBase defaults.
# AUTH_ISSUER=https://identity.example.com
# AUTH_AUDIENCE=kele-platform
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# New accounts are created only by a verified /auth/exchange with explicit consent.
# Existing-account request verification never creates accounts.
AUTH_ALLOW_SIGNUP=false
# Migrations and deletion maintenance use separate privileged connections.
# Never use a migration owner as DATABASE_URL or expose credentials to the browser.

